# ── Supabase (zorunlu) ────────────────────────────────────────────────
# Proje → Settings → API ekranından kopyala. Gerçek değerleri .env dosyasına yaz,
# bu şablonu asla gerçek anahtarlarla commit ETME.
VITE_SUPABASE_URL=https://xxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...        # public anon key (RLS ile korunur)

# ── Hata izleme (opsiyonel) ───────────────────────────────────────────
# Sentry yoksa boş bırak; main.tsx yalnızca doluysa başlatır.
VITE_SENTRY_DSN=

# ── Capacitor / Android (paketleme sırasında) ─────────────────────────
# Uygulamanın erişeceği kesin public URL (AI Studio preview adresi kalıcı değildir):
CAPACITOR_SERVER_URL=https://english-base-panel.netlify.app
